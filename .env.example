# Kopieren nach .env und anpassen:  cp .env.example .env
# Die .env enthält keine Bankdaten – PINs gibst du in der App ein (verschlüsselt gespeichert).

# Pflicht für Bankabrufe: Produkt-ID der Deutschen Kreditwirtschaft
# (kostenlos beantragen: https://www.fints.org/de/hersteller/produktregistrierung)
BANKPOCKET_FINTS_PRODUCT_ID=

# Automatische Abrufe (Ortszeit). Banken erlauben ohne deine Mitwirkung nur wenige Abrufe pro Tag.
BANKPOCKET_ABRUFZEITEN=06:45,11:45,16:45,21:45
TZ=Europe/Berlin

# Absender für Web-Push (geht an den Push-Dienst des Browsers, darf eine Dummy-Adresse sein)
BANKPOCKET_PUSH_KONTAKT=mailto:admin@localhost

# Tägliche Sicherung (Datenbank + Schlüsseldateien) nach data/backups/. Mit Passwort wird sie verschlüsselt;
# mit Ziel zusätzlich hochgeladen – ein rclone-Ziel (vorher mit „rclone config“ einrichten) oder ein Ordner.
# Das Passwort unbedingt außerhalb des Servers aufbewahren (Passwortmanager) – ohne es ist die Sicherung wertlos.
BANKPOCKET_BACKUP_PASSWORT=
BANKPOCKET_BACKUP_ZIEL=
# Beispiel: BANKPOCKET_BACKUP_ZIEL=meinecloud:Backup/BankPocket

# Port im Heimnetz (http, ohne Push). Läuft alles über Tailscale, besser nur lokal: BANKPOCKET_PORT=127.0.0.1:8000
BANKPOCKET_PORT=8000

# HTTPS über Tailscale: Einmal-Schlüssel aus https://login.tailscale.com/admin/settings/keys
# Nach der ersten Anmeldung wird er nicht mehr gebraucht und kann hier wieder gelöscht werden.
TS_AUTHKEY=

# Nur für die Alternative „HTTPS mit Caddy im Heimnetz“: IP deines Servers und Port
BANKPOCKET_HOST=192.168.1.10
BANKPOCKET_HTTPS_PORT=8443
